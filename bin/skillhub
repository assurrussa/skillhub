#!/bin/sh
set -eu

if [ -n "${SKILLHUB_REPO:-}" ]; then
  repo_root="$SKILLHUB_REPO"
else
  repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fi
caller_cwd=$(pwd)
SKILLHUB_CALLER_CWD="${SKILLHUB_CALLER_CWD:-$caller_cwd}"
export SKILLHUB_CALLER_CWD

if command -v go >/dev/null 2>&1 && [ -f "$repo_root/go.mod" ]; then
  cd "$repo_root"
  exec go run ./cmd/skillhub "$@"
fi

if [ ! -f "$repo_root/go.mod" ]; then
  printf 'skillhub repository is missing go.mod: %s\n' "$repo_root" >&2
  exit 1
fi

printf 'Go is required to run skillhub from a checkout. Install Go or run sh install.sh to build the installed binary.\n' >&2
exit 1
